---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "@fontsource-variable/onest";
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Más de 3 años programando. Desarrollador Full Stack Vue Js/ React Js/ .NET. Estudiante avanzado de sistemas, en el Instituto Superior Tecnológico Empresarial Argentino."
		/>

		<link rel="icon" type="image/svg+xml" href="/favi.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:title" content="Mi portfolio - Nicolás Ibarra" />
		<meta
			property="og:description"
			content="Soy Nicolás, desarrollador junior especializado en Vue.js. ¡Conocé mis proyectos!"
		/>
		<meta
			property="og:image"
			content="https://nicolas-agustin-ibarra.vercel.app/img/perfil.jpeg"
		/>
		<meta
			property="og:url"
			content="https://nicolas-agustin-ibarra.vercel.app/"
		/>
		<meta property="og:type" content="website" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Mi portfolio - Nicolás Ibarra" />
		<meta
			name="twitter:description"
			content="Soy Nicolás, desarrollador junior especializado en Vue.js. ¡Conocé mis proyectos!"
		/>
		<meta
			name="twitter:image"
			content="https://nicolas-agustin-ibarra.vercel.app/img/perfil.jpeg"
		/>
	</head>

	<body>
		<!-- <div
			class="absolute inset-0 -z-10 h-full lg:w-full w-[540px] 
			items-center px-5 py-24 [background:radial-gradient(125%_125%_at_50%_10%,#000_60%,#63e_100%)]"
		>
		</div> -->
		<Header />
		<slot />
		<Footer />
	</body>
</html>
<style is:global>
	:root {
		color-scheme: ligth dark;
	}
	html {
		font-family: "Onest Variable", sans-serif;
		scroll-behavior: smooth;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: #000;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
